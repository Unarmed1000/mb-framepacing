# Line endings: stored as LF in the repository, native in checkouts (CRLF on Windows, LF elsewhere)
* text=auto

# Scripts keep the line endings their shell needs, on every OS
*.sh   text eol=lf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# The pacer's golden data is compared byte for byte, with the LF line ends pacer-sim writes, on every OS
sdk/test-data/pacer/*.csv text eol=lf

# Binary files: never convert line endings or show text diffs
*.png  binary
*.pgm  binary
*.mbfc binary
*.mbcd binary
*.mp4  binary
