<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:MB.FramePacing.Gui.ViewModels"
  x:Class="MB.FramePacing.Gui.Views.SettingsView"
  x:DataType="vm:SettingsViewModel"
>
  <ScrollViewer>
    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <!-- ffmpeg and the captures folder: the configuration file, changed through the setup dialog -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="ffmpeg and captures" />
          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Classes="subtle" Text="ffmpeg" />
            <TextBlock Grid.Column="1" Text="{Binding FfmpegSummary}" Classes.ok="{Binding FfmpegReady}" Classes.error="{Binding !FfmpegReady}" />
            <TextBlock Grid.Row="1" Classes="subtle" Text="ffmpeg path" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding FfmpegPathText}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Classes="subtle" Text="Captures folder" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding CaptureDirectoryText}" TextWrapping="Wrap" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
              Classes="accent"
              Content="Set up..."
              Command="{Binding SetUpCommand}"
              ToolTip.Tip="Find ffmpeg and choose where captures are saved"
            />
            <Button Content="Open the configuration file" Command="{Binding OpenConfigFileCommand}" ToolTip.Tip="{Binding ConfigPath}" />
          </StackPanel>
          <TextBlock
            Classes="error"
            Text="{Binding StatusText}"
            TextWrapping="Wrap"
            IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          />
        </StackPanel>
      </Border>

      <!-- The playback page's answers about the recording: the configuration file, shared with the command line -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="Playback page" />
          <TextBlock
            Classes="subtle"
            TextWrapping="Wrap"
            Text="Save playback page (Analyze page) and 'render --playback' write the report next to the recording the capture was imported from, in the analysis's playback folder. What they do with the recording:"
          />
          <Grid ColumnDefinitions="240,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <TextBlock Classes="subtle" VerticalAlignment="Center" Text="Recordings browsers can play" />
            <ComboBox
              Grid.Column="1"
              MinWidth="260"
              ItemsSource="{Binding PlaybackVideoChoices}"
              SelectedIndex="{Binding PlaybackVideoIndex}"
              ToolTip.Tip="A copy makes the playback folder play anywhere on its own (it takes the recording's size again); a link needs the recording where it is. Stored as playbackVideo."
            />
            <TextBlock Grid.Row="1" Classes="subtle" VerticalAlignment="Center" Text="Recordings browsers cannot play" />
            <ComboBox
              Grid.Row="1"
              Grid.Column="1"
              MinWidth="260"
              ItemsSource="{Binding PlaybackTranscodeChoices}"
              SelectedIndex="{Binding PlaybackTranscodeIndex}"
              ToolTip.Tip="Lossless and 4:4:4 recordings, HEVC, and containers like MKV: ffmpeg makes a copy browsers play, with every frame and its timestamp kept. Stored as playbackTranscode."
            />
          </Grid>
          <TextBlock
            Classes="error"
            Text="{Binding PlaybackStatusText}"
            TextWrapping="Wrap"
            IsVisible="{Binding PlaybackStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          />
        </StackPanel>
      </Border>

      <!-- Experimental features: hidden (and never used) unless switched on -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="Experimental features" />
          <CheckBox Content="Enable experimental features" IsChecked="{Binding ExperimentalFeatures}" />
          <TextBlock
            Classes="subtle"
            TextWrapping="Wrap"
            Text="Live capture: record a capture card or a network stream directly (the suggested way is a recording of the card, imported as a video file). Camera capture (very experimental): film the screen with a calibrated high speed camera. When enabled, the Capture page shows the capture cards, the network stream, the Camera card and the synthetic camera source; when disabled, they are hidden and a camera set up earlier is not used."
          />
          <TextBlock Classes="warning" Text="{Binding ExperimentalText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Where things are -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="cardTitle" Text="About" />
          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Classes="subtle" Text="Version" />
            <TextBlock Grid.Column="1" Classes="value" Text="{Binding Version}" />
            <TextBlock Grid.Row="1" Classes="subtle" Text="Configuration" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding ConfigPath}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Classes="subtle" Text="GUI settings" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding GuiSettingsPath}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Classes="subtle" Text="Log files" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding LogDirectory}" TextWrapping="Wrap" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
              Content="Open the log folder"
              Command="{Binding OpenLogFolderCommand}"
              ToolTip.Tip="The GUI writes a log file per day here, the last 7 days kept: attach it when reporting a problem"
            />
          </StackPanel>
          <TextBlock
            Classes="error"
            Text="{Binding LogStatusText}"
            TextWrapping="Wrap"
            IsVisible="{Binding LogStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
          />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
