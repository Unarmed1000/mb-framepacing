  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\FramePacing.Gui\FramePacing.Gui.csproj" />
  </ItemGroup>
</Project>
