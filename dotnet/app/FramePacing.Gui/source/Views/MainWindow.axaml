<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MB.FramePacing.Gui.ViewModels"
        xmlns:views="using:MB.FramePacing.Gui.Views"
        x:Class="MB.FramePacing.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1320" Height="880" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Classes="header">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="mb-framepacing" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="animation error from in-frame markers" VerticalAlignment="Bottom" Margin="0,0,0,2" />
        </StackPanel>
        <Border Grid.Column="2" Classes="pill" Classes.bad="{Binding !FfmpegReady}" VerticalAlignment="Center" ToolTip.Tip="{Binding FfmpegToolTip}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" IsVisible="{Binding FfmpegReady}" />
            <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" IsVisible="{Binding !FfmpegReady}" />
            <TextBlock Text="{Binding FfmpegSummary}" FontSize="12" />
          </StackPanel>
        </Border>
        <Button Grid.Column="3" Content="Settings" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="ffmpeg and where captures are saved" />
      </Grid>
    </Border>

    <TabControl SelectedIndex="{Binding SelectedTab}" Margin="12,4,12,12">
      <TabItem Header="Capture">
        <views:CaptureView DataContext="{Binding Capture}" Margin="0,8,0,0" />
      </TabItem>
      <TabItem Header="Analyze">
        <views:AnalysisView DataContext="{Binding Analysis}" Margin="0,8,0,0" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
