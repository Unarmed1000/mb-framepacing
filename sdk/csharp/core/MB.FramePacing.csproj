<Project Sdk="Microsoft.NET.Sdk">
  <!-- The core of the C# SDK: the types every module shares (Point, Rectangle, the time types). No dependencies, .NET Standard 2.1 and C# 9 without nullable
       annotations, so the same sources also compile inside Unity (2021.3+). Nothing here may allocate on the per-frame path. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MB.FramePacing</AssemblyName>
    <RootNamespace>MB.FramePacing</RootNamespace>
    <Product>MB Frame Pacing</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MB.FramePacing.UnitTest" />
  </ItemGroup>
</Project>
