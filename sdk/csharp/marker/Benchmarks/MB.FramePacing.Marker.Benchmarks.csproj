<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tool: BenchmarkDotNet measurements of every per-frame step of the marker module (the C++ module's benchmarks, group for
       group). Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>MB.FramePacing.Marker.Benchmarks</AssemblyName>
    <RootNamespace>MB.FramePacing.Marker.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MB.FramePacing.Marker.csproj" />
  </ItemGroup>

  <!-- The reference the QR encoder is compared with and measured against (the encoder the module had before): not part of the library -->
  <ItemGroup>
    <Compile Include="..\Reference\ReferenceQrEncoder.cs" Link="Reference\ReferenceQrEncoder.cs" />
  </ItemGroup>
</Project>
