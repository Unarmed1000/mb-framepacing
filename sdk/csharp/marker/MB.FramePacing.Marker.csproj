<Project Sdk="Microsoft.NET.Sdk">
  <!-- The marker module of the C# SDK. No dependencies, .NET Standard 2.1 (Span) and C# 9 without nullable annotations, so the same sources also
       compile inside Unity (2021.3+). Nothing here may allocate on the per-frame path. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MB.FramePacing.Marker</AssemblyName>
    <RootNamespace>MB.FramePacing.Marker</RootNamespace>
    <Product>MB Frame Pacing Marker</Product>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MB.FramePacing.Marker.UnitTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\MB.FramePacing.csproj" />
  </ItemGroup>
</Project>
