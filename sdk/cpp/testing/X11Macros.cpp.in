// Generated by CMake (testing/X11Macros.cpp.in, mb_framepacing_add_x11_macro_check): every public header of the
// @MB_FRAMEPACING_CHECKED_MODULE@ module, as an application has them that included X11's headers first. Xlib.h and X.h define plain
// words as macros (an enumerator named None, a member named Status, will not compile after them), and Vulkan's and EGL's platform
// headers pull them in on Linux. This file only has to compile.
//
// clang-format off
#define None 0L
#define Status int
#define Bool int
#define True 1
#define False 0
#define Success 0
#define Always 2
#define Above 0
#define Below 1
#define Opposite 4
#define Complex 0
#define Nonconvex 1
#define Convex 2
#define Unsorted 0
#define Expose 12
#define KeyPress 2
#define KeyRelease 3
#define FocusIn 9
#define FocusOut 10
#define CurrentTime 0L
#define DestroyAll 0
#define ControlMask (1 << 2)

@MB_FRAMEPACING_CHECKED_INCLUDES@
// clang-format on

namespace MB::FramePacing::Testing
{
  //! Something to link, so the file is never empty
  int X11MacroCheck@MB_FRAMEPACING_CHECKED_MODULE@() noexcept
  {
    return 0;
  }
}
